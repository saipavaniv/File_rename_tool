# Copy this file to .env and adjust (run_local.bat makes a simple local one for you). Never commit .env.

# Address people type in the browser (comma-separated). Requests for any other host name are refused.
ALLOWED_HOSTS=hop.local,localhost

# HTTPS (strongly recommended). Create a certificate with:  python scripts/make_cert.py hop.local
SSL_CERTFILE=certs/server.crt
SSL_KEYFILE=certs/server.key
PORT=8443
# Keep true whenever HTTPS is used. Only set false for a local test on http://localhost.
COOKIE_SECURE=true

# Database: SQLite file by default (fine for one site). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://renamer:STRONG_PASSWORD@db-host/renamer
# DATA_DIR=data

# Limits
MAX_UPLOAD_MB=50
ANALYSIS_WORKERS=2
ANALYSIS_TIMEOUT=90
SESSION_HOURS=8
IDLE_MINUTES=60
LOGIN_MAX_FAILS=5
LOCK_MINUTES=15

# Optional tools
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe

# Only true when running behind a reverse proxy (nginx/IIS) that sets X-Forwarded-For
TRUST_PROXY=false
ENABLE_API_DOCS=false
